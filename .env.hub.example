# Copy to .env.hub and fill in real values for the project hub deployment (spec 005).
# Never commit the filled-in file (constitution rule 7); .env.hub is gitignored.
#   cp .env.hub.example .env.hub
#   docker compose -f docker-compose.hub.yml --env-file .env.hub build sandbox
#   docker compose -f docker-compose.hub.yml --env-file .env.hub up -d --build --wait
# Fixed in docker-compose.hub.yml, so not set here: OIDC_CLIENT_ID=collab,
# COOKIE_SECURE=true, RUNNER_URL, SANDBOX_MAX_CONCURRENT=2.

# Where the app lives on the hub. APP_BASE_PATH is the frontend build arg (trailing
# slash); BASE_PATH is the same path without it.
APP_BASE_PATH=/collab/
BASE_PATH=/collab
# The public address of the app, used for the sign-in redirect.
PUBLIC_BASE_URL=https://hub.example.ts.net/collab

# Postgres (service `db`). DATABASE_URL must embed the same user, password and db name;
# its host is the compose service name "db".
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=collab
DATABASE_URL=postgresql://postgres:changeme@db:5432/collab

# Single sign-on: the hub's Keycloak, realm `hub`.
OIDC_ISSUER=https://hub.example.ts.net/auth/realms/hub
# Read over the hub network rather than through the public address.
OIDC_METADATA_URL=http://auth:8080/auth/realms/hub/.well-known/openid-configuration
# The `collab` client secret, printed once by the hub's bin/add-client.
OIDC_CLIENT_SECRET=changeme
# Role names on the `collab` client.
ROLE_EDITOR=editor
ROLE_ADMIN=admin

# Signs the session cookie; any long random string.
SESSION_COOKIE_KEY=changeme
# How long a sign-in lasts here, in seconds.
SESSION_MAX_AGE_SECONDS=3600

# The sandbox image the runner starts per run (built from sandbox/Dockerfile).
SANDBOX_IMAGE=collab-sandbox:latest
# Set to "runsc" where gVisor is installed on the host; blank otherwise.
SANDBOX_RUNTIME=
