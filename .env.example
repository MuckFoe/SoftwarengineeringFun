# Copy to .env and fill in real values. Never commit the filled-in file (constitution
# rule 7); .env is gitignored.
#   cp .env.example .env
#   docker compose up -d --build

# Postgres (service `db`). DATABASE_URL must embed the same user, password and db name;
# its host is the compose service name "db".
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=collab
DATABASE_URL=postgresql://postgres:changeme@db:5432/collab

# Single sign-on: the organisation's Keycloak, external to this compose file.
OIDC_ISSUER=https://keycloak.example.com/realms/collab-coding
OIDC_CLIENT_ID=collab-coding
OIDC_CLIENT_SECRET=changeme
ROLE_EDITOR=editor
ROLE_ADMIN=admin

# Signs the session cookie (Starlette SessionMiddleware); any long random string.
SESSION_COOKIE_KEY=changeme
# How long a sign-in lasts here, in seconds; a role removed in Keycloak stops working
# within this time.
SESSION_MAX_AGE_SECONDS=3600

# The runner, reached over the compose network only.
RUNNER_URL=http://runner:8080

# The sandbox image the runner starts per run (built and pinned by sandbox/Dockerfile).
SANDBOX_IMAGE=collab-sandbox:latest
# Set to "runsc" where gVisor is installed on the host; blank otherwise.
SANDBOX_RUNTIME=
