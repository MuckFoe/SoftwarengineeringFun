{
  "title": "First Occurrences Only",
  "description": "Return the elements of a list of integers in their original order, keeping only the first occurrence of each value.",
  "signature": "def unique_elements(xs: list[int]) -> list[int]",
  "topic": "arrays",
  "difficulty": "easy",
  "tests": [
    { "args": [[1, 2, 2, 3, 1]], "expected": [1, 2, 3] },
    { "args": [[]], "expected": [] },
    { "args": [[5]], "expected": [5] },
    { "args": [[1, 1, 1, 1]], "expected": [1] },
    { "args": [[4, 3, 2, 1]], "expected": [4, 3, 2, 1] }
  ]
}
