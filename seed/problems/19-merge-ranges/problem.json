{
  "title": "Merge Overlapping Ranges",
  "description": "Given a list of [start, end] integer ranges, merge all ranges that overlap or touch (one starts exactly where another ends) and return the merged ranges sorted by start.",
  "signature": "def merge_ranges(ranges: list[list[int]]) -> list[list[int]]",
  "topic": "intervals",
  "difficulty": "medium",
  "tests": [
    {
      "args": [[[1, 3], [2, 6], [8, 10], [15, 18]]],
      "expected": [[1, 6], [8, 10], [15, 18]]
    },
    { "args": [[]], "expected": [] },
    { "args": [[[1, 4], [4, 5]]], "expected": [[1, 5]] },
    { "args": [[[1, 2], [3, 4]]], "expected": [[1, 2], [3, 4]] },
    { "args": [[[5, 6], [1, 2]]], "expected": [[1, 2], [5, 6]] }
  ]
}
